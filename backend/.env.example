# Copy to .env and use the local PostgreSQL credentials configured in pgAdmin.

PORT=5000
DATABASE_URL=postgresql://YOUR_PG_USER:YOUR_PG_PASSWORD@localhost:5432/YOUR_DATABASE_NAME

# Optional DJI Neo / GCP planning thresholds (defaults shown)
# MAX_AGL_M=120
# NEO_BATTERY_RESERVE=0.2
# GCP_MAX_SPREAD_M=1000
# GCP_MAX_FROM_CASE_M=2000

# Car damage detection test page
# PYTHON_BIN=python3   # or "python" on Windows / a venv path
# DAMAGE_TIMEOUT_MS=120000
JWT_SECRET=SecurePassword123!
WEBODM_API_URL=http://localhost:8000
WEBODM_TOKEN=your_webodm_api_token_here
JWT_SECRET=change_me_to_a_long_random_string

# --- WebODM (runs in Docker; the backend talks to it, users never open it) ---
WEBODM_URL=http://localhost:8000
WEBODM_USERNAME=your_webodm_admin_username
WEBODM_PASSWORD=your_webodm_admin_password
# WEBODM_UPLOAD_BATCH=10
# WEBODM_POLL_MS=5000
# WEBODM_MAX_MINUTES=240
# WEBODM_MIN_IMAGES=5

# --- Damage detection (absolute path to the python inside backend/venv is safest) ---
# PYTHON_BIN=C:\path\to\backend\venv\Scripts\python.exe
# DAMAGE_CONF=0.25