# Copy to .env and use the local PostgreSQL credentials configured in pgAdmin.

PORT=5000
DATABASE_URL=postgresql://YOUR_PG_USER:YOUR_PG_PASSWORD@localhost:5432/YOUR_DATABASE_NAME

# Optional DJI Neo / GCP planning thresholds (defaults shown)
# MAX_AGL_M=120
# NEO_BATTERY_RESERVE=0.2
# GCP_MAX_SPREAD_M=1000
# GCP_MAX_FROM_CASE_M=2000
